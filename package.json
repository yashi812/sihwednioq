{
  "name": "winddesk",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm --dir frontend dev -- --host 0.0.0.0\" \"cd backend && .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload\"",
    "build": "pnpm --dir frontend build",
    "preview": "pnpm --dir frontend preview --host 0.0.0.0",
    "api": "cd backend && .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
